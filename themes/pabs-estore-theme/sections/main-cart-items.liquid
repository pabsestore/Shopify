{% comment %} Main Cart Items — required by templates/cart.json (type: main-cart-items) {% endcomment %}
<section class="section">
  <div class="page-width">
    <h1 style="font-family:'Orbitron',monospace;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 14px">Your Cart</h1>
    <div class="circuit-divider" style="margin-bottom:18px"></div>

    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:48px 20px;background:linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);border:1px solid rgba(255,255,255,0.08);border-radius:16px">
        <p style="margin:0 0 8px;font-size:18px;font-weight:700">Cart is empty</p>
        <p style="margin:0 0 16px;color:var(--text-muted)">Add RGB gear — shipping unlocks at $75</p>
        <a href="{{ routes.collections_url }}" class="btn btn--neon">Continue Shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display:grid;gap:12px">
          {% for item in cart.items %}
            <div style="display:grid;grid-template-columns:84px 1fr auto;gap:14px;align-items:center;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:12px">
              <a href="{{ item.url }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.title, style: 'width:84px;height:84px;object-fit:cover;border-radius:10px;border:1px solid rgba(255,255,255,0.08)' }}
                {% else %}
                  <div style="width:84px;height:84px;display:grid;place-items:center;background:#0B1028;border-radius:10px;color:var(--text-dim);font-size:11px">No image</div>
                {% endif %}
              </a>
              <div>
                <a href="{{ item.url }}" style="font-weight:700;line-height:1.3">{{ item.product.title | escape }}</a>
                {% unless item.product.has_only_default_variant %}<div style="color:var(--text-dim);font-size:12.5px">{{ item.variant.title }}</div>{% endunless %}
                {% if section.settings.show_vendor %}<div style="color:var(--text-dim);font-size:12px">{{ item.product.vendor }}</div>{% endif %}
                <div style="margin-top:6px;display:flex;gap:8px;align-items:center">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity" style="width:72px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:#fff;padding:8px 10px;border-radius:999px;text-align:center">
                  <a href="{{ item.url_to_remove }}" style="font-size:12px;color:var(--text-dim);text-decoration:underline">Remove</a>
                </div>
              </div>
              <div style="text-align:right">
                <div style="font-weight:800;color:var(--cyan)">{{ item.final_line_price | money }}</div>
                {% if item.original_line_price != item.final_line_price %}<s style="color:var(--text-dim);font-size:12px">{{ item.original_line_price | money }}</s>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="margin-top:18px;display:grid;gap:14px;grid-template-columns:1fr;align-items:start">
          <style>@media(min-width:900px){ .cart-totals-grid{grid-template-columns:1fr 360px} }</style>
          <div class="cart-totals-grid" style="display:grid;gap:14px">
            <div style="background:linear-gradient(180deg, rgba(0,229,255,0.08) 0%, rgba(168,85,247,0.08) 100%);border:1px solid rgba(0,229,255,0.18);border-radius:14px;padding:16px">
              <p style="margin:0 0 6px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;font-size:12px">Order Note</p>
              <textarea name="note" placeholder="Add delivery instructions..." rows="3" style="width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:#fff;padding:10px 12px;border-radius:12px;resize:vertical">{{ cart.note }}</textarea>
              <p style="margin:10px 0 0;color:var(--text-dim);font-size:12px">Shipping & taxes calculated at checkout • Free shipping $75+</p>
            </div>
            <div style="background:linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:16px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span style="color:var(--text-muted)">Subtotal</span><span style="font-weight:800;font-size:18px;color:var(--cyan)">{{ cart.total_price | money }}</span>
              </div>
              <button type="submit" name="update" class="btn btn--ghost" style="width:100%;margin-bottom:10px">Update Cart</button>
              <button type="submit" name="checkout" class="btn btn--neon" style="width:100%">Checkout →</button>
              <div style="text-align:center;margin-top:10px"><a href="{{ routes.collections_url }}" style="font-size:12.5px;color:var(--text-muted);text-decoration:underline">← Continue shopping</a></div>
            </div>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Main Cart — Neon",
  "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }],
  "presets": [{ "name": "Main Cart — Neon" }]
}
{% endschema %}
