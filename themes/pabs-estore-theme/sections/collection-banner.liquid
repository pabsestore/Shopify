{% comment %} Collection Banner — matches templates/collection.json type: collection-banner {% endcomment %}
<section class="section" style="padding-bottom:12px">
  <div class="page-width">
    <div style="background:linear-gradient(135deg, rgba(0,229,255,0.10) 0%, rgba(168,85,247,0.12) 100%);border:1px solid rgba(0,229,255,0.18);border-radius:16px;padding:22px;display:grid;gap:10px">
      <h1 style="margin:0;font-family:'Orbitron',monospace;letter-spacing:0.08em;text-transform:uppercase;font-size:clamp(22px,3.5vw,28px)">{{ collection.title | default: 'Collection' | escape }}</h1>
      {% if section.settings.show_collection_description and collection.description != blank %}
        <div style="color:var(--text-muted);max-width:70ch;font-size:14px;line-height:1.6">{{ collection.description }}</div>
      {% endif %}
      {% if section.settings.show_collection_image and collection.featured_image %}
        <div style="margin-top:8px;border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);max-width:720px">
          {{ collection.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: collection.title }}
        </div>
      {% endif %}
      <div style="color:var(--text-dim);font-size:12.5px;letter-spacing:0.06em;text-transform:uppercase">{{ collection.products_count }} products • Free shipping $75+</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection Banner — Neon",
  "settings": [
    { "type": "checkbox", "id": "show_collection_description", "label": "Show description", "default": true },
    { "type": "checkbox", "id": "show_collection_image", "label": "Show collection image", "default": false }
  ],
  "presets": [{ "name": "Collection Banner — Neon" }]
}
{% endschema %}
