{% comment %} Featured Collection — Pabs Neon override {% endcomment %}
<section class="section section--featured-collection">
  <div class="page-width">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:18px">
      <div>
        <h2 class="section__heading">{{ section.settings.title | default: 'Trending Right Now' | escape }}</h2>
        {% if section.settings.subtext != blank %}
          <p class="section__subtext" style="margin:0">{{ section.settings.subtext | escape }}</p>
        {% endif %}
      </div>
      <a href="{{ section.settings.collection.url | default: routes.collections_url }}" class="btn btn--ghost" style="padding:10px 18px;font-size:12.5px">View All →</a>
    </div>

    {% assign coll = section.settings.collection %}
    {% if coll != blank and coll.products.size > 0 %}
      <div class="product-grid">
        {% for product in coll.products limit: section.settings.products_to_show %}
          <div class="card product-card">
            <a href="{{ product.url }}">
              <div style="aspect-ratio:1;background:#0B1028;overflow:hidden">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div style="height:100%;display:grid;place-items:center;color:var(--text-dim)">No image</div>
                {% endif %}
              </div>
              <div style="padding:14px">
                <h3 style="margin:0 0 6px;font-size:14px;font-weight:700;line-height:1.35">{{ product.title | escape }}</h3>
                <div class="price">{{ product.price | money }}</div>
                {% if section.settings.show_rating and product.metafields.reviews.rating.value != blank %}
                  <div style="font-size:12px;color:var(--text-dim)">★ {{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count }})</div>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-grid">
        {% for i in (1..8) %}
          <div class="card" style="padding:18px;text-align:center">
            <div style="height:160px;display:grid;place-items:center;background:linear-gradient(135deg, rgba(0,229,255,0.12), rgba(168,85,247,0.12));border-radius:12px;margin-bottom:12px;border:1px solid rgba(255,255,255,0.08)">
              <span style="font-size:28px">
                {% cycle '⌨️', '🖱️', '🎧', '📹', '🎙️', '💡', '🎮', '🖥️' %}
              </span>
            </div>
            <h3 style="margin:0 0 6px;font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--cyan)">Sample Product {{ i }}</h3>
            <p style="margin:0 0 8px;font-size:12.5px;color:var(--text-muted)">Add products in Shopify Admin → Products</p>
            <div class="price">$29.99</div>
          </div>
        {% endfor %}
      </div>
      <p style="text-align:center;margin-top:16px;color:var(--text-dim);font-size:13px">No products yet — import via DSers / Spocket / CJdropshipping app, then assign to collection "{{ coll.title | default: 'All' }}"</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Neon Featured Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Trending Right Now" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "TikTok-viral RGB gear — 2–7d US shipping" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "default": 8, "label": "Products to show" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "default": 4, "label": "Columns desktop" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true }
  ],
  "presets": [{ "name": "Neon Featured Collection" }]
}
{% endschema %}
