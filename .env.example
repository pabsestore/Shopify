# Copy this file to `.env` and fill in your real values, then never
# commit `.env` itself (it is gitignored).
#
# Find these in the Shopify DEV DASHBOARD -> your app -> Settings:
#   - Client ID
#   - Client secret (starts with shpss_)
#
# SHOPIFY_API_VERSION = quarterly Shopify API release, e.g. 2026-01.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_API_SECRET=your-client-secret
SHOPIFY_API_VERSION=2026-07